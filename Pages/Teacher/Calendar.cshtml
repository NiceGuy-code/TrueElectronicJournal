@page "/Teacher/Calendar"
@model Journal.Pages.Teacher.CalendarModel
@{
    ViewData["Title"] = "Календарь";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Календарь</h3>
    <div class="d-flex gap-2">
        <a asp-page="/Teacher/Calendar"
           asp-route-date="@Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd")"
           class="btn btn-outline-secondary btn-sm">← Предыдущая</a>
        <a asp-page="/Teacher/Calendar"
           asp-route-date="@Model.Today.ToString("yyyy-MM-dd")"
           class="btn btn-outline-secondary btn-sm">Сегодня</a>
        <a asp-page="/Teacher/Calendar"
           asp-route-date="@Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd")"
           class="btn btn-outline-secondary btn-sm">Следующая →</a>
    </div>
</div>

<div class="text-muted small mb-3">
    @Model.WeekStart.ToString("dd.MM.yyyy") – @Model.WeekStart.AddDays(6).ToString("dd.MM.yyyy")
</div>

@{
    var dayNames = new[] { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" };
}

<div class="row row-cols-7 g-2">
    @for (var i = 0; i < Model.WeekDays.Count; i++)
    {
        var day = Model.WeekDays[i];
        var isToday = day.Date == Model.Today;
        var dayLessons = Model.Lessons.Where(l => l.DateFrom.Date == day.Date).ToList();
        <div class="col">
            <div class="card p-2 @(isToday ? "border border-dark" : "")">
                <div class="text-muted small mb-2">@dayNames[i] @day.ToString("dd.MM")</div>
                @if (!dayLessons.Any())
                {
                    <div class="text-muted small fst-italic">—</div>
                }
                else
                {
                    @foreach (var l in dayLessons)
                    {
                        <a asp-page="/Teacher/Lesson" asp-route-id="@l.Id"
                           class="text-decoration-none text-dark">
                            <div class="card p-2 mb-1 bg-light">
                                <div class="small">@l.DateFrom.ToString("HH:mm") – @l.DateTo.ToString("HH:mm")</div>
                                <div>@l.SubjectName</div>
                                <div class="text-muted small">
                                    @l.GroupName
                                    @if (!string.IsNullOrEmpty(l.Topic))
                                    {
                                        <text> · @l.Topic</text>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>
    }
</div>
