@page
@model Journal.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Доступ запрещён";
}

<div class="card p-4 p-lg-5 mx-auto text-center journal-in" style="max-width: 440px; margin-top: 56px;">
    <span class="journal-eyebrow text-center">Ошибка 403</span>
    <h3 class="mb-3">Доступ запрещён</h3>
    <p class="text-muted mb-4">У вас нет прав для этого раздела.</p>
    <a class="btn btn-primary w-100" asp-page="/Index">На главную</a>
</div>
