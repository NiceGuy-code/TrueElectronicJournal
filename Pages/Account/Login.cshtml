@page
@model Journal.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="card p-4 p-lg-5 mx-auto journal-in" style="max-width: 440px; margin-top: 56px;">
    <span class="journal-eyebrow text-center">Электронный журнал</span>
    <h3 class="mb-4 text-center">Вход</h3>
    <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" placeholder="user@example.com" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Input.Password" class="form-label">Пароль</label>
            <input asp-for="Input.Password" class="form-control" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Войти</button>
    </form>
    <div class="mt-4 text-center text-muted small" style="border-top: 1px solid var(--j-line); padding-top: 16px;">
        Для получения доступа обратитесь к администратору
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
