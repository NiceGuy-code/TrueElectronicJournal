@page
@model Journal.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Выход";
}

<div class="card p-4 mx-auto text-center" style="max-width: 420px; margin-top: 60px;">
    <h4 class="mb-3">Выход</h4>
    <p class="text-muted mb-3">Вы уверены, что хотите выйти?</p>
    <form method="post">
        <button type="submit" class="btn btn-primary w-100">Выйти</button>
    </form>
</div>
