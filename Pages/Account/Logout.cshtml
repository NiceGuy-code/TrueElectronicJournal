@page
@model Journal.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Выход";
}

<div class="card p-4 p-lg-5 mx-auto text-center journal-in" style="max-width: 440px; margin-top: 56px;">
    <span class="journal-eyebrow text-center">Электронный журнал</span>
    <h3 class="mb-3">Выход</h3>
    <p class="text-muted mb-4">Вы уверены, что хотите выйти?</p>
    <form method="post">
        <button type="submit" class="btn btn-primary w-100">Выйти</button>
    </form>
</div>
