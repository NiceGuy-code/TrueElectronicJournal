@page
@model Journal.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="card shadow-sm p-4 mx-auto" style="max-width: 420px; margin-top: 60px;">
    <h4 class="mb-3 text-center">Регистрация</h4>
    <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <div class="mb-3">
            <label asp-for="Input.FullName" class="form-label">ФИО</label>
            <input asp-for="Input.FullName" class="form-control" placeholder="Иванов Иван Иванович" />
            <span asp-validation-for="Input.FullName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" placeholder="user@example.com" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label">Пароль</label>
            <input asp-for="Input.Password" class="form-control" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.ConfirmPassword" class="form-label">Повторите пароль</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Зарегистрироваться</button>
    </form>
    <div class="mt-3 text-center">
        <a asp-page="/Account/Login">Уже есть аккаунт? Вход</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
