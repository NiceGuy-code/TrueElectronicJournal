@page "/Admin/Index"
@model Journal.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Администрирование";
}

<h3 class="m-0 mb-3">Администрирование</h3>

<div class="row row-cols-2 row-cols-md-4 g-3 mb-3">
    <div class="col">
        <a asp-page="/Admin/Users/Index" class="card p-3 h-100 text-decoration-none text-dark d-block">
            <div class="fs-2">@Model.TotalUsers</div>
            <div class="text-muted mt-1">Пользователи</div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Admin/Users/Index" class="card p-3 h-100 text-decoration-none text-dark d-block">
            <div class="fs-2">@Model.Students</div>
            <div class="text-muted mt-1">Студенты</div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Admin/Users/Index" class="card p-3 h-100 text-decoration-none text-dark d-block">
            <div class="fs-2">@Model.Teachers</div>
            <div class="text-muted mt-1">Учителя</div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Admin/Users/Index" class="card p-3 h-100 text-decoration-none text-dark d-block">
            <div class="fs-2">@Model.Admins</div>
            <div class="text-muted mt-1">Администраторы</div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Admin/Groups/Index" class="card p-3 h-100 text-decoration-none text-dark d-block">
            <div class="fs-2">@Model.Groups</div>
            <div class="text-muted mt-1">Группы</div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Admin/Subjects/Index" class="card p-3 h-100 text-decoration-none text-dark d-block">
            <div class="fs-2">@Model.Subjects</div>
            <div class="text-muted mt-1">Предметы</div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Admin/Schedule/Index" class="card p-3 h-100 text-decoration-none text-dark d-block">
            <div class="fs-2">@Model.Lessons</div>
            <div class="text-muted mt-1">Занятия</div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Admin/Announcements/Index" class="card p-3 h-100 text-decoration-none text-dark d-block">
            <div class="fs-2">@Model.Announcements</div>
            <div class="text-muted mt-1">Объявления</div>
        </a>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 g-3">
    <div class="col">
        <div class="card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Последние объявления</h5>
                <a asp-page="/Admin/Announcements/Index" class="btn-link small">Все</a>
            </div>
            @if (!Model.RecentAnnouncements.Any())
            {
                <div class="text-muted">Нет данных</div>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var a in Model.RecentAnnouncements)
                    {
                        <li class="mb-2">
                            <div>@a.Title</div>
                            <div class="text-muted small">@a.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
    <div class="col">
        <div class="card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Ближайшие занятия</h5>
                <a asp-page="/Admin/Schedule/Index" class="btn-link small">Все</a>
            </div>
            @if (!Model.UpcomingLessons.Any())
            {
                <div class="text-muted">Нет данных</div>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var l in Model.UpcomingLessons)
                    {
                        <li class="mb-2">
                            <div>@l.SubjectName — @l.GroupName</div>
                            <div class="text-muted small">@l.DateFrom.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
