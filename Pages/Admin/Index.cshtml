@page "/Admin/Index"
@model Journal.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Администрирование";
}

<div class="journal-head">
    <div>
        <span class="journal-eyebrow">Панель управления</span>
        <h3>Администрирование</h3>
    </div>
</div>

<div class="row row-cols-2 row-cols-md-4 g-3 mb-4 journal-stagger">
    <div class="col">
        <a asp-page="/Admin/Users/Index" class="card text-decoration-none text-dark d-block position-relative">
            <div class="journal-stat">
                <svg class="journal-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 12L12 4M12 4H5.5M12 4V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="journal-value">@Model.TotalUsers</div>
                <div class="journal-stat-label">Пользователи</div>
            </div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Admin/Users/Index" class="card text-decoration-none text-dark d-block position-relative">
            <div class="journal-stat">
                <svg class="journal-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 12L12 4M12 4H5.5M12 4V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="journal-value">@Model.Students</div>
                <div class="journal-stat-label">Студенты</div>
            </div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Admin/Users/Index" class="card text-decoration-none text-dark d-block position-relative">
            <div class="journal-stat">
                <svg class="journal-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 12L12 4M12 4H5.5M12 4V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="journal-value">@Model.Teachers</div>
                <div class="journal-stat-label">Учителя</div>
            </div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Admin/Users/Index" class="card text-decoration-none text-dark d-block position-relative">
            <div class="journal-stat">
                <svg class="journal-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 12L12 4M12 4H5.5M12 4V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="journal-value">@Model.Admins</div>
                <div class="journal-stat-label">Администраторы</div>
            </div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Admin/Groups/Index" class="card text-decoration-none text-dark d-block position-relative">
            <div class="journal-stat">
                <svg class="journal-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 12L12 4M12 4H5.5M12 4V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="journal-value">@Model.Groups</div>
                <div class="journal-stat-label">Группы</div>
            </div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Admin/Subjects/Index" class="card text-decoration-none text-dark d-block position-relative">
            <div class="journal-stat">
                <svg class="journal-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 12L12 4M12 4H5.5M12 4V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="journal-value">@Model.Subjects</div>
                <div class="journal-stat-label">Предметы</div>
            </div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Admin/Schedule/Index" class="card text-decoration-none text-dark d-block position-relative">
            <div class="journal-stat">
                <svg class="journal-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 12L12 4M12 4H5.5M12 4V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="journal-value">@Model.Lessons</div>
                <div class="journal-stat-label">Занятия</div>
            </div>
        </a>
    </div>
    <div class="col">
        <a asp-page="/Admin/Announcements/Index" class="card text-decoration-none text-dark d-block position-relative">
            <div class="journal-stat">
                <svg class="journal-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 12L12 4M12 4H5.5M12 4V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="journal-value">@Model.Announcements</div>
                <div class="journal-stat-label">Объявления</div>
            </div>
        </a>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 g-3">
    <div class="col">
        <div class="card p-4 h-100 journal-in">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
                <div>
                    <span class="journal-eyebrow">Активность</span>
                    <h5 class="mb-0">Последние объявления</h5>
                </div>
                <a asp-page="/Admin/Announcements/Index" class="small text-decoration-none">Все&nbsp;→</a>
            </div>
            @if (!Model.RecentAnnouncements.Any())
            {
                <div class="text-muted">Нет данных</div>
            }
            else
            {
                <ul class="journal-list">
                    @foreach (var a in Model.RecentAnnouncements)
                    {
                        <li class="d-flex justify-content-between gap-3 align-items-baseline">
                            <div>@a.Title</div>
                            <div class="text-muted small text-nowrap">@a.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
    <div class="col">
        <div class="card p-4 h-100 journal-in">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
                <div>
                    <span class="journal-eyebrow">Расписание</span>
                    <h5 class="mb-0">Ближайшие занятия</h5>
                </div>
                <a asp-page="/Admin/Schedule/Index" class="small text-decoration-none">Все&nbsp;→</a>
            </div>
            @if (!Model.UpcomingLessons.Any())
            {
                <div class="text-muted">Нет данных</div>
            }
            else
            {
                <ul class="journal-list">
                    @foreach (var l in Model.UpcomingLessons)
                    {
                        <li class="d-flex justify-content-between gap-3 align-items-baseline">
                            <div>
                                <div>@l.SubjectName — @l.GroupName</div>
                            </div>
                            <div class="text-muted small text-nowrap">@l.DateFrom.ToString("dd.MM.yyyy HH:mm")</div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
