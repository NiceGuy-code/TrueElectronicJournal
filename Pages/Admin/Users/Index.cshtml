@page "/Admin/Users"
@model Journal.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Пользователи";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Пользователи</h3>
    <a asp-page="/Admin/Users/Create" class="btn btn-primary">Создать</a>
</div>

<div class="card p-4">
    <table class="table table-sm journal-table mb-0">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Email</th>
                <th>Роль</th>
                <th>Группа</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-muted">Пользователей нет</td>
            </tr>
        }
        @foreach (var u in Model.Rows)
        {
            <tr>
                <td>@u.FullName</td>
                <td>@u.Email</td>
                <td>@(string.IsNullOrEmpty(u.Role) ? "—" : u.Role)</td>
                <td>@(string.IsNullOrEmpty(u.GroupName) ? "—" : u.GroupName)</td>
                <td class="text-end">
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled>Изменить</button>
                    <button type="button" class="btn btn-danger btn-sm" disabled>Удалить</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
