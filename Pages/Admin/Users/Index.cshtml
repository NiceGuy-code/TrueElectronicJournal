@page "/Admin/Users"
@model Journal.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Пользователи";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Пользователи</h3>
    <a asp-page="/Admin/Users/Create" class="btn btn-primary">Создать</a>
</div>

@if (TempData["Error"] is string err)
{
    <div class="text-danger mb-2">@err</div>
}

<div class="card p-4">
    <form method="get" class="d-flex gap-2 align-items-end mb-3">
        <div>
            <label class="form-label small mb-1">Роль</label>
            <select asp-for="SelectedRole" class="form-select form-select-sm">
                <option value="">Все</option>
                @foreach (var r in Model.Roles)
                {
                    <option value="@r">@r</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">Группа</label>
            <select asp-for="SelectedGroupId" class="form-select form-select-sm">
                <option value="">Все</option>
                @foreach (var g in Model.Groups)
                {
                    <option value="@g.Id">@g.Name</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Применить</button>
        @if (Model.HasFilter)
        {
            <a href="/Admin/Users" class="btn btn-outline-secondary btn-sm">Сбросить</a>
        }
    </form>
    <table class="table table-sm journal-table mb-0">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Email</th>
                <th>Роль</th>
                <th>Группа</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-muted">Пользователей нет</td>
            </tr>
        }
        @foreach (var u in Model.Rows)
        {
            <tr>
                <td>@u.FullName</td>
                <td>@u.Email</td>
                <td>@(string.IsNullOrEmpty(u.Role) ? "—" : u.Role)</td>
                <td>@(string.IsNullOrEmpty(u.GroupName) ? "—" : u.GroupName)</td>
                <td class="text-end">
                    <a asp-page="/Admin/Users/Edit" asp-route-id="@u.Id" class="btn btn-outline-secondary btn-sm">Изменить</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@u.Id" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Удалить пользователя?')">Удалить</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
