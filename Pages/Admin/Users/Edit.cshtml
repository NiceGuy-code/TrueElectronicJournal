@page "/Admin/Users/Edit/{id}"
@model Journal.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Редактирование пользователя";
}

<div class="card p-4 mx-auto" style="max-width: 520px;">
    <h3 class="mb-3 text-center">Редактирование пользователя</h3>
    <form method="post" asp-route-id="@Model.UserId">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <input type="hidden" name="id" value="@Model.UserId" />

        <div class="mb-3">
            <label asp-for="Input.FullName" class="form-label">ФИО</label>
            <input asp-for="Input.FullName" class="form-control" />
            <span asp-validation-for="Input.FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" placeholder="user@example.com" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Role" class="form-label">Роль</label>
            <select asp-for="Input.Role" class="form-select" asp-items="Model.RoleItems"></select>
            <span asp-validation-for="Input.Role" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.GroupId" class="form-label">Группа</label>
            <select asp-for="Input.GroupId" class="form-select" asp-items="Model.GroupItems"></select>
            <span asp-validation-for="Input.GroupId" class="text-danger"></span>
            <div class="form-text">Только для роли Student</div>
        </div>

        <div class="mb-3">
            <label asp-for="Input.NewPassword" class="form-label">Новый пароль</label>
            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            <div class="form-text">Оставьте пустым, чтобы не менять</div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a asp-page="/Admin/Users/Index" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
