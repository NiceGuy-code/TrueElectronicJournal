@page "/Admin/Subjects"
@model Journal.Pages.Admin.Subjects.IndexModel
@{
    ViewData["Title"] = "Предметы";
}

<div class="journal-head">
    <div>
        <span class="journal-eyebrow">Справочник</span>
        <h3>Предметы</h3>
        <div class="journal-metrics">
            <span><b>@Model.Items.Count</b> предметов</span>
            <span><b>@Model.Items.Sum(s => s.LessonsCount)</b> занятий</span>
        </div>
    </div>
    <a asp-page="/Admin/Subjects/Create" class="btn btn-primary">Создать</a>
</div>

@if (TempData["Error"] is string err)
{
    <div class="text-danger mb-3">@err</div>
}

<div class="card p-4 journal-in">
    <table class="table journal-table mb-0">
        <thead>
            <tr>
                <th>Название</th>
                <th>Занятий</th>
                <th>Учителей</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-muted">Предметов нет</td>
            </tr>
        }
        @foreach (var s in Model.Items)
        {
            <tr>
                <td class="journal-strong">@s.Name</td>
                <td>@s.LessonsCount</td>
                <td>@s.TeachersCount</td>
                <td class="text-end text-nowrap">
                    <a asp-page="/Admin/Subjects/Edit" asp-route-id="@s.Id"
                       class="btn btn-outline-secondary btn-sm">Изменить</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id"
                          class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Удалить предмет?')">Удалить</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
