@page "/Admin/Schedule"
@model Journal.Pages.Admin.Schedule.IndexModel
@{
    ViewData["Title"] = "Расписание";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Расписание</h3>
    <div class="d-flex gap-2">
        <a asp-page="/Admin/Schedule/Calendar" class="btn btn-outline-secondary">Календарь</a>
        <a asp-page="/Admin/Schedule/CreateRecurring" class="btn btn-outline-secondary">Создать на период</a>
        <a asp-page="/Admin/Schedule/Create" class="btn btn-primary">Создать</a>
    </div>
</div>

@if (TempData["Success"] is string s)
{
    <div class="alert alert-secondary mb-3">@s</div>
}
@if (TempData["Error"] is string err)
{
    <div class="text-danger mb-2">@err</div>
}

<div class="card p-4">
    <table class="table table-sm journal-table mb-0">
        <thead>
            <tr>
                <th>Дата</th>
                <th>Время</th>
                <th>Предмет</th>
                <th>Группа</th>
                <th>Учитель</th>
                <th>Тема</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-muted">Занятий нет</td>
            </tr>
        }
        @foreach (var l in Model.Items)
        {
            <tr>
                <td>@l.DateFrom.ToString("dd.MM.yyyy")</td>
                <td>@l.DateFrom.ToString("HH:mm") – @l.DateTo.ToString("HH:mm")</td>
                <td>@l.SubjectName</td>
                <td>@l.GroupName</td>
                <td>@l.TeacherName</td>
                <td>@(string.IsNullOrEmpty(l.Topic) ? "—" : l.Topic)</td>
                <td>
                    <a asp-page="/Admin/Schedule/Edit" asp-route-id="@l.Id"
                       class="btn btn-outline-secondary btn-sm">Изменить</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@l.Id"
                          class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Удалить занятие?')">Удалить</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
