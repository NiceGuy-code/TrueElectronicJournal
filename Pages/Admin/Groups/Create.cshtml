@page "/Admin/Groups/Create"
@model Journal.Pages.Admin.Groups.CreateModel
@{
    ViewData["Title"] = "Создание группы";
}

<div class="card p-4 mx-auto" style="max-width: 520px;">
    <h3 class="mb-3 text-center">Новая группа</h3>
    <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="Input.Name" class="form-label">Название</label>
            <input asp-for="Input.Name" class="form-control" placeholder="ИУ7-11Б" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a asp-page="/Admin/Groups/Index" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
