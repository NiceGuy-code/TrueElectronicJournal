@page "/Admin/Groups"
@model Journal.Pages.Admin.Groups.IndexModel
@{
    ViewData["Title"] = "Группы";
}

<div class="journal-head">
    <div>
        <span class="journal-eyebrow">Справочник</span>
        <h3>Группы</h3>
        <div class="journal-metrics">
            <span><b>@Model.Rows.Count</b> групп</span>
            <span><b>@Model.Rows.Sum(r => r.StudentsCount)</b> студентов</span>
            <span><b>@Model.Rows.Sum(r => r.LessonsCount)</b> занятий</span>
        </div>
    </div>
    <a asp-page="/Admin/Groups/Create" class="btn btn-primary">Создать</a>
</div>

@if (TempData["Error"] is string err)
{
    <div class="text-danger mb-3">@err</div>
}

<div class="card p-4 journal-in">
    <table class="table journal-table mb-0">
        <thead>
            <tr>
                <th>Название</th>
                <th>Студентов</th>
                <th>Занятий</th>
                <th>Последнее занятие</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-muted">Групп нет</td>
            </tr>
        }
        @foreach (var g in Model.Rows)
        {
            <tr>
                <td class="journal-strong">@g.Name</td>
                <td>@g.StudentsCount</td>
                <td>@g.LessonsCount</td>
                <td class="text-muted">@(g.LastLessonDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                <td class="text-end text-nowrap">
                    <a asp-page="/Admin/Groups/Edit" asp-route-id="@g.Id"
                       class="btn btn-outline-secondary btn-sm">Изменить</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@g.Id"
                          class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Удалить группу?')">Удалить</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
