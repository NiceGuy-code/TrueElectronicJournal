@page "/Admin/Announcements"
@model Journal.Pages.Admin.Announcements.IndexModel
@{
    ViewData["Title"] = "Объявления";
}

<div class="journal-head">
    <div>
        <span class="journal-eyebrow">Коммуникации</span>
        <h3>Объявления</h3>
        <div class="journal-metrics">
            <span><b>@Model.Items.Count</b> опубликовано</span>
        </div>
    </div>
    <a asp-page="/Admin/Announcements/Create" class="btn btn-primary">Создать</a>
</div>

@if (!Model.Items.Any())
{
    <div class="card p-4"><div class="text-muted">Объявлений нет</div></div>
}
else
{
    <div class="row row-cols-1 g-4 journal-stagger">
        @foreach (var a in Model.Items)
        {
            <div class="col">
                <article class="card h-100">
                    @if (a.ImagePath != null)
                    {
                        <div class="ann-media">
                            <img src="@a.ImagePath" alt="" />
                        </div>
                    }
                    <div class="p-4 p-lg-5">
                        <h4 class="ann-title">@a.Title</h4>
                        <div class="ann-meta">
                            <span>@a.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                            <span>@(a.Author?.FullName ?? "—")</span>
                            @if (a.GroupId == null)
                            {
                                <span>Для всех групп</span>
                            }
                            else
                            {
                                <span>@a.Group?.Name</span>
                            }
                        </div>
                        <div class="ann-text">@a.Text</div>
                    </div>
                </article>
            </div>
        }
    </div>
}
