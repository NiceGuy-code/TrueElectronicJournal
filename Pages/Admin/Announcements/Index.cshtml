@page "/Admin/Announcements"
@model Journal.Pages.Admin.Announcements.IndexModel
@{
    ViewData["Title"] = "Объявления";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Объявления</h3>
    <a asp-page="/Admin/Announcements/Create" class="btn btn-primary">Создать</a>
</div>

@if (!Model.Items.Any())
{
    <div class="card p-4"><div class="text-muted">Объявлений нет</div></div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 g-3">
        @foreach (var a in Model.Items)
        {
            <div class="col">
                <div class="card p-4 h-100">
                    <div class="row g-3">
                        @if (a.ImagePath != null)
                        {
                            <div class="col-md-4">
                                <img src="@a.ImagePath" class="img-fluid" alt="" />
                            </div>
                        }
                        <div class="@(a.ImagePath != null ? "col-md-8" : "col")">
                            <h5 class="mb-2">@a.Title</h5>
                            <div class="text-muted small mb-2">
                                @a.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                · @(a.Author?.FullName ?? "—")
                                @if (a.GroupId == null)
                                {
                                    <text> · Для всех</text>
                                }
                                else
                                {
                                    <text> · @a.Group?.Name</text>
                                }
                            </div>
                            <div style="white-space: pre-wrap;">@a.Text</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
