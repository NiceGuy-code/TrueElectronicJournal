@page "/Student/Announcements"
@model Journal.Pages.Student.AnnouncementsModel
@{
    ViewData["Title"] = "Объявления";
}

<h3 class="mb-3">Объявления</h3>

@if (Model.Items.Count == 0)
{
    <div class="text-muted">Объявлений нет</div>
}
else
{
    @foreach (var a in Model.Items)
    {
        <div class="card p-4 mb-3" style="max-width: 720px;">
            <div class="row g-3">
                @if (a.ImagePath != null)
                {
                    <div class="col-md-3">
                        <img src="@a.ImagePath" class="img-fluid" alt="" />
                    </div>
                }
                <div class="@(a.ImagePath != null ? "col-md-9" : "col")">
                    <h5 class="mb-1">@a.Title</h5>
                    <div class="text-muted small mb-2">
                        @a.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        · @(a.Author?.FullName ?? "—")
                        @if (a.GroupId != null)
                        {
                            <text> · для @a.Group?.Name</text>
                        }
                    </div>
                    <div style="white-space: pre-wrap;">@a.Text</div>
                </div>
            </div>
        </div>
    }
}
