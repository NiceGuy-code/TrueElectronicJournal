@page "/Student/Grades"
@model Journal.Pages.Student.GradesModel
@{
    ViewData["Title"] = "Оценки";
}

@if (Model.NoGroup)
{
    <h3 class="mb-3">Оценки</h3>
    <div class="card p-4"><div class="text-muted">Вы не привязаны к группе</div></div>
    return;
}

@if (Model.Subject == null)
{
    <h3 class="mb-3">Оценки</h3>

    <div class="card p-4 mb-3">
        <div class="fs-2">@(Model.OverallAverage?.ToString("F2") ?? "—")</div>
        <div class="text-muted small mt-1">Оценок: @Model.OverallCount</div>
    </div>

    <div class="card p-4">
        <h5 class="mb-3">Сводка по предметам</h5>
        @if (!Model.Summary.Any(s => s.Count > 0))
        {
            <div class="text-muted">Оценок нет</div>
        }
        else
        {
            <table class="table table-sm journal-table mb-0">
                <thead>
                    <tr>
                        <th>Предмет</th>
                        <th>Оценок</th>
                        <th>Средний балл</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Summary)
                    {
                        <tr>
                            <td>
                                <a asp-page="/Student/Grades" asp-route-subject="@s.SubjectName"
                                   class="text-dark text-decoration-underline">@s.SubjectName</a>
                            </td>
                            <td>@(s.Count > 0 ? s.Count.ToString() : "—")</td>
                            <td>@(s.Count > 0 ? s.Average.ToString("F2") : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
else
{
    <div class="mb-2">
        <a asp-page="/Student/Grades" class="text-dark text-decoration-underline small">← Все предметы</a>
    </div>
    <h3 class="mb-3">@Model.Subject</h3>

    <div class="card p-4 mb-3">
        <div class="d-flex gap-5">
            <div>
                <div class="fs-2">@(Model.SubjectAverage?.ToString("F2") ?? "—")</div>
                <div class="text-muted small mt-1">средний балл</div>
            </div>
            <div>
                <div class="fs-2">@Model.SubjectCount</div>
                <div class="text-muted small mt-1">оценок</div>
            </div>
        </div>
    </div>

    <div class="card p-4">
        <h5 class="mb-3">Список оценок</h5>
        @if (Model.SubjectGrades.Count == 0)
        {
            <div class="text-muted">Оценок нет</div>
        }
        else
        {
            <ul class="list-unstyled mb-0">
                @foreach (var g in Model.SubjectGrades)
                {
                    <li class="d-flex justify-content-between mb-2">
                        <span>@g.Date.ToString("dd.MM")</span>
                        <span class="grade-@g.Value">@g.Value</span>
                    </li>
                }
            </ul>
        }
    </div>
}
