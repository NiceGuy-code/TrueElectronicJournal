@page "/Student/Grades"
@model Journal.Pages.Student.GradesModel
@{
    ViewData["Title"] = "Оценки";
}

<h3 class="mb-3">Оценки</h3>

@if (Model.NoGroup)
{
    <div class="card p-4"><div class="text-muted">Вы не привязаны к группе</div></div>
    return;
}

<div class="card p-4">
    <table class="table table-sm journal-table mb-0">
        <thead>
            <tr>
                <th>Дата</th>
                <th>Предмет</th>
                <th>Тема</th>
                <th>Оценка</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="5" class="text-muted">Занятий нет</td></tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Date.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td>@item.SubjectName</td>
                        <td>@item.Topic</td>
                        <td>
                            @if (item.Grade != null)
                            {
                                <span class="grade-@item.Grade">@item.Grade</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (item.Status == "н/б")
                            {
                                <span class="grade-na">н/б</span>
                            }
                            else if (item.Status == "н")
                            {
                                <span class="grade-absent">н</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
