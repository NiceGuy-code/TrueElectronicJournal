@page "/Student/Index"
@using Journal.Models
@model Journal.Pages.Student.IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="journal-head">
    <div>
        <span class="journal-eyebrow">Личный кабинет</span>
        <h3>Главная</h3>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-3 mb-4 journal-stagger">
    <div class="col">
        <div class="card h-100">
            <div class="journal-stat">
                <div class="journal-value">@(Model.AverageGrade?.ToString("F2") ?? "—")</div>
                <div class="journal-stat-label">@(Model.GradesCount > 0 ? $"{Model.GradesCount} оценок" : "оценок нет")</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="journal-stat">
                <div class="journal-value">@(Model.Attendance.HasValue ? $"{Model.Attendance.Value:F0}%" : "—")</div>
                <div class="journal-stat-label">@(Model.TotalLessons > 0 ? $"{Model.TotalLessons - Math.Min(Model.Absences, Model.TotalLessons)} из {Model.TotalLessons} занятий" : "занятий нет")</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="journal-stat">
                <div class="journal-value text-truncate" title="@(Model.GroupName ?? "—")">@(Model.GroupName ?? "—")</div>
                <div class="journal-stat-label">текущая группа</div>
            </div>
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-3">
    <div class="col">
        <div class="card p-4 h-100 journal-in">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
                <div>
                    <span class="journal-eyebrow">Оценки</span>
                    <h5 class="mb-0">Последние записи</h5>
                </div>
                <a asp-page="/Student/Grades" class="small text-decoration-none">Все&nbsp;→</a>
            </div>
            @if (!Model.RecentGrades.Any())
            {
                <div class="text-muted">Нет данных</div>
            }
            else
            {
                <ul class="journal-list">
                    @foreach (var g in Model.RecentGrades)
                    {
                        <li class="d-flex justify-content-between align-items-baseline gap-3">
                            <div>
                                <div>@g.SubjectName</div>
                                <div class="text-muted small">@g.Date.ToString("dd.MM")</div>
                            </div>
                            <div>
                                @if (g.Value != null)
                                {
                                    <span class="grade-@g.Value">@g.Value</span>
                                }
                                else if (g.Type == GradeType.NA)
                                {
                                    <span class="grade-na">н/б</span>
                                }
                                else if (g.Attendance == AttendanceType.Unexcused)
                                {
                                    <span class="grade-na">Н</span>
                                }
                                else if (g.Attendance == AttendanceType.Excused)
                                {
                                    <span class="grade-absent">УП</span>
                                }
                                else if (g.Attendance == AttendanceType.Late)
                                {
                                    <span class="text-muted">ОП</span>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
    <div class="col">
        <div class="card p-4 h-100 journal-in">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
                <div>
                    <span class="journal-eyebrow">Расписание</span>
                    <h5 class="mb-0">Ближайшие занятия</h5>
                </div>
                <a asp-page="/Student/Schedule" class="small text-decoration-none">Все&nbsp;→</a>
            </div>
            @if (!Model.UpcomingLessons.Any())
            {
                <div class="text-muted">Нет данных</div>
            }
            else
            {
                <ul class="journal-list">
                    @foreach (var l in Model.UpcomingLessons)
                    {
                        <li class="d-flex justify-content-between align-items-baseline gap-3">
                            <div>
                                <div>@l.SubjectName</div>
                                <div class="text-muted small">@l.TeacherName</div>
                            </div>
                            <div class="text-muted small text-nowrap">
                                @l.DateFrom.ToString("dd.MM") · @l.DateFrom.ToString("HH:mm")
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
    <div class="col">
        <div class="card p-4 h-100 journal-in">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
                <div>
                    <span class="journal-eyebrow">Новости</span>
                    <h5 class="mb-0">Свежие объявления</h5>
                </div>
                <a asp-page="/Student/Announcements" class="small text-decoration-none">Все&nbsp;→</a>
            </div>
            @if (!Model.RecentAnnouncements.Any())
            {
                <div class="text-muted">Нет данных</div>
            }
            else
            {
                <ul class="journal-list">
                    @foreach (var a in Model.RecentAnnouncements)
                    {
                        <li class="d-flex justify-content-between align-items-baseline gap-3">
                            <div>@a.Title</div>
                            <div class="text-muted small text-nowrap">@a.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
